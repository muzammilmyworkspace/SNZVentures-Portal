# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets ignored, the documented template is committed
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# audit artefacts
/audit-shots
/audit-report.json
/audit-final.log
/.server.log

# portal data store (dev file adapter)
/.data

# portal review screenshots
/portal-shots

# theme comparison screenshots
/theme-shots

# Client-supplied source photographs — large originals, imported via
# scripts/import-client-images.mjs into public/images as optimised WebP.
/Images
migrations.sql
